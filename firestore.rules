rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns this document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ==================== PROFILES ====================
    // Users can read all profiles (for finding players)
    // Users can only write their own profile
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      // Profiles should not be deleted (use soft delete if needed)
      allow delete: if false;
    }

    // ==================== FCM TOKENS ====================
    // Users can only read/write their own FCM token
    match /fcmTokens/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ==================== VENUES ====================
    // All authenticated users can read venues
    // All authenticated users can create venues
    // Only the creator can update or delete their venue
    match /venues/{venueId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid;
    }

    // ==================== NOTIFICATIONS ====================
    // Users can only access notifications sent to them
    match /notifications/{notificationId} {
      allow read: if isAuthenticated()
        && resource.data.playerId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.playerId == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.playerId == request.auth.uid;
      // Notifications are created by Cloud Functions, not clients
      allow create: if false;
    }

    // ==================== CONVERSATIONS ====================
    // Users can only access conversations they are a participant in
    match /conversations/{conversationId} {
      // Check if user is a participant (conversation ID format: sortedId1_sortedId2)
      function isParticipant() {
        return request.auth.uid in resource.data.participantIds
          || conversationId.matches('.*' + request.auth.uid + '.*');
      }

      function willBeParticipant() {
        return request.auth.uid in request.resource.data.participantIds;
      }

      allow read: if isAuthenticated() && isParticipant();
      allow create: if isAuthenticated() && willBeParticipant();
      allow update: if isAuthenticated() && isParticipant();
      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && request.resource.data.sentBy == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
